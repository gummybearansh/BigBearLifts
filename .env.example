# Copy to .env and fill in. Never commit .env.
# .env is gitignored. This example contains no personal data.

# Local Postgres from docker-compose.dev.yml.
# On EC2, point this at the compose network hostname `postgres`.
DATABASE_URL=postgresql://bbl:change-me@localhost:5432/bigbearlifts
POSTGRES_PASSWORD=change-me

# Auth. Generate a secret with: openssl rand -base64 32
# Generate the password hash with: npm run hash-password -- "your-password"
# Store the hash, never the password. Leave the $ characters as-is.
# Only `npm run db:seed` reads APP_PASSWORD_HASH. The Next.js server does not,
# because Next expands $ in .env files and would corrupt a bcrypt hash.
# Auth.js reads AUTH_SECRET; NEXTAUTH_SECRET is the same value.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
AUTH_TRUST_HOST=true
APP_USERNAME=
APP_PASSWORD_HASH=

# Personal stats. Required. Server-only — they are not baked into the client bundle.
# Used later for BMI, FFMI, and bodyweight-exercise volume.
HEIGHT_CM=
BODYWEIGHT_KG=

# Optional path to a gitignored catalog. See data/personal-seed.example.json.
# data/personal-seed.json is gitignored. Leave blank to skip the catalog seed.
SEED_FILE=

# Optional one-time weigh-in seed. Leave blank to skip.
SEED_METRIC_DATE=
SEED_METRIC_WEIGHT_KG=
SEED_METRIC_SMM_KG=
SEED_METRIC_BODY_FAT_PCT=

# Push (Milestone 9)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Video uploads (Milestone 8)
UPLOAD_DIR=/var/www/bigbearlifts/uploads
MAX_UPLOAD_MB=500

# Public defaults from the design system. Safe to keep.
NEXT_PUBLIC_APP_NAME=BigBearLifts
NEXT_PUBLIC_DEFAULT_REST_SEC=90
NEXT_PUBLIC_ACCENT=#FF5A1F
